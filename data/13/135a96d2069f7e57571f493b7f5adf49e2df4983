         (grouped <span class="org-comment-delimiter">; </span><span class="org-comment">((text . (start start start)) ...)</span>
          (mapcar
           (<span class="org-keyword">lambda</span> (o)
             (cons (car o)
                   (mapcar
                    (<span class="org-keyword">lambda</span> (sub) (elt sub 1))
                    (cdr o))))
           (seq-group-by
            (<span class="org-keyword">lambda</span> (o) (elt o 3))
            (seq-remove (<span class="org-keyword">lambda</span> (o)
                          (<span class="org-keyword">and</span> (elt o 4)
                               (string-match <span class="org-string">"#\\+SKIP"</span> (elt o 4)))) <span class="org-warning">subtitles))))</span>
         (one-group (= (length grouped) 1)))
    (seq-mapcat
     (<span class="org-keyword">lambda</span> (o)
       (<span class="org-keyword">setq</span> group-num (1+ group-num))
