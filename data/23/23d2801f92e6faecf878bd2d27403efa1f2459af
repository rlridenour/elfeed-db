<script>
(function () {
  function initMap(root) {
    var panel = root.querySelector("[data-dash-panel]");
    var tips = root.querySelectorAll("[data-dash-tip]");
    var hotspots = root.querySelectorAll("[data-dash-hotspot]");
    var closeBtn = root.querySelector("[data-dash-close]");
    var activeId = null;

    function hideAll() {
      tips.forEach(function (tip) { tip.hidden = true; });
      hotspots.forEach(function (btn) {
        btn.classList.remove("is-active");
        btn.setAttribute("aria-expanded", "false");
      });
      panel.hidden = true;
      activeId = null;
    }

    function show(id) {
      hideAll();
      var tip = root.querySelector('[data-dash-tip="' + id + '"]');
      var btn = root.querySelector('[data-dash-hotspot="' + id + '"]');
      if (!tip || !btn) return;
      tip.hidden = false;
      panel.hidden = false;
      btn.classList.add("is-active");
      btn.setAttribute("aria-expanded", "true");
      activeId = id;
    }

    hotspots.forEach(function (btn) {
      var id = btn.getAttribute("data-dash-hotspot");
      btn.addEventListener("click", function () {
        if (activeId === id) hideAll();
        else show(id);
      });
      btn.addEventListener("mouseenter", function () {
        if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
          show(id);
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener("click", hideAll);

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && activeId) hideAll();
    });
  }

  document.querySelectorAll("[data-dash-map]").forEach(initMap);
})();
</script>

<p>Almost every one of these widgets was created with the help of my AI
agent. You don&rsquo;t have to learn all of the ins and outs of TerminalWidget
to make a beautiful and useful dashboard. Just point your agent at the
documentation and tell it what you want to display/chart/graph.</p>

