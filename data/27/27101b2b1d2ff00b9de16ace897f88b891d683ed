) <span style="color: #ea3d54; font-weight: bold;">else</span> <span style="color: #ea3d54; font-weight: bold;">if</span> /<span style="color: #ee7b29;">I</span> <span style="color: #4fb3d8;">"%ACTION%"</span>==<span style="color: #4fb3d8;">"rebuild"</span> (
