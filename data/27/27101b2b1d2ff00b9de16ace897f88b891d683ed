<span style="color: #ea3d54; font-weight: bold;">goto</span> <span style="color: #ee7b29;">:end</span><br>
<span style="font-weight: bold;">:process_project</span>
    <span style="color: #fedd38;">setlocal</span> EnableDelayedExpansion
