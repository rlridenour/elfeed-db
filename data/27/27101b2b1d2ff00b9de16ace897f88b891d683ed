<span style="color: #ea3d54; font-weight: bold;">if</span> /<span style="color: #ee7b29;">I</span> <span style="color: #4fb3d8;">"%ACTION%"</span>==<span style="color: #4fb3d8;">"clean"</span> <span style="color: #fedd38;">set</span> <span style="color: #cbccd1;">TARGET</span>=Clean
<span style="color: #ea3d54; font-weight: bold;">if</span> /<span style="color: #ee7b29;">I</span> <span style="color: #4fb3d8;">"%ACTION%"</span>==<span style="color: #4fb3d8;">"restore"</span> <span style="color: #fedd38;">set</span> <span style="color: #cbccd1;">TARGET</span>=Restore
<span style="color: #ea3d54; font-weight: bold;">if</span> /<span style="color: #ee7b29;">I</span> <span style="color: #4fb3d8;">"%ACTION%"</span>==<span style="color: #4fb3d8;">"rebuild"</span> <span style="color: #fedd38;">set</span> <span style="color: #cbccd1;">TARGET</span>=Rebuild<br>
