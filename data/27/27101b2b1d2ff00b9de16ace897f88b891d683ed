)<br>
<span style="color: #5B6268;">REM </span><span style="color: #5B6268;">Process all active projects
</span><span style="color: #ea3d54; font-weight: bold;">for</span> /<span style="color: #ee7b29;">L</span> %%<span style="color: #cbccd1;">i</span> <span style="color: #ea3d54; font-weight: bold;">in</span> (1,1,%<span style="color: #cbccd1;">PROJECT_COUNT</span>%) <span style="color: #ea3d54; font-weight: bold;">do</span> (
