</span><span style="color: #fedd38;">set</span> <span style="color: #cbccd1;">BUILD_PARAMS</span>=/<span style="color: #ee7b29;">p</span>:Configuration=%<span style="color: #cbccd1;">CONFIGURATION</span>% /<span style="color: #ee7b29;">p</span>:Platform=<span style="color: #4fb3d8;">"%PLATFORM%"</span> /<span style="color: #ee7b29;">verbosity</span>:%<span style="color: #cbccd1;">VERBOSITY</span>%<br>
<span style="color: #5B6268;">REM </span><span style="color: #5B6268;">Set MSBuild target based on action
