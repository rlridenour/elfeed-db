</span>    msbuild <span style="color: #4fb3d8;">"!PROJECT_PATH!"</span> /<span style="color: #ee7b29;">t</span>:%<span style="color: #cbccd1;">target</span>% %<span style="color: #cbccd1;">BUILD_PARAMS</span>%
