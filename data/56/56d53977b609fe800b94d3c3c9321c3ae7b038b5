              <span class="org-rainbow-delimiters-depth-7">(</span><span class="org-keyword">if</span> <span class="org-rainbow-delimiters-depth-8">(</span>re-search-forward <span class="org-string">"^[0-9]+\\."</span> nil t<span class="org-rainbow-delimiters-depth-8">)</span>
