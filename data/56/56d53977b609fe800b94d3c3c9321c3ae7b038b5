</span>    <span class="org-rainbow-delimiters-depth-3">(</span><span class="org-keyword">unless</span> <span class="org-rainbow-delimiters-depth-4">(</span>looking-at <span class="org-string">"[[:space:]]*[0-9]+\\."</span><span class="org-rainbow-delimiters-depth-4">)</span>
