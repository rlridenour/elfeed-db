</span><span style="color: #6a9955; font-weight: bold; font-style: italic;">REM   </span><span style="color: #6a9955; font-weight: bold; font-style: italic;">verbosity: quiet, minimal, normal, detailed, diagnostic (default: minimal)
</span><span style="color: #6a9955; font-weight: bold; font-style: italic;">REM   </span><span style="color: #6a9955; font-weight: bold; font-style: italic;">configuration: Debug, Release (default: Debug)
</span><span style="color: #6a9955; font-weight: bold; font-style: italic;">REM   </span><span style="color: #6a9955; font-weight: bold; font-style: italic;">platform: x64, x86, "Any CPU" (default: x64)
