<span style="color: #569cd6; font-weight: bold;">if</span> <span style="color: #ce9178; font-style: italic;">"%ACTION%"</span>==<span style="color: #ce9178; font-style: italic;">""</span> <span style="color: #c586c0; font-weight: bold;">set</span> <span style="color: #9cdcfe; font-weight: bold; font-style: italic;">ACTION</span>=build
