                         (string <span style="color: #483d8b;">:tag</span> <span style="color: #8b2252;">"Url (%s denotes search word)"</span>)
                         (<span style="color: #a020f0;">function</span> <span style="color: #483d8b;">:tag</span> <span style="color: #8b2252;">"Parsing function"</span>))))
</code></pre>
