(<span class="org-keyword">defun</span> <span class="org-function-name">my-lang-subed-record-get-last-attempt</span> (item file)
  <span class="org-doc">"Return the last subtitle matching ITEM in FILE."</span>
  (car
   (last
    (seq-remove
     (<span class="org-keyword">lambda</span> (o) (string-match <span class="org-string">"#\\+SKIP"</span> (<span class="org-keyword">or</span> (elt o 4) <span class="org-string">""</span>)))
