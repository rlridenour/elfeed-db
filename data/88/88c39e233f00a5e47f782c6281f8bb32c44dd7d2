(<span class="org-keyword">defun</span> <span class="org-function-name">my-lang-summarize-segments</span> (items files prefix attempt-fn cell-fn <span class="org-type">&amp;optional</span> always-create)
  (cons
   (append
    (seq-map <span class="org-highlight-quoted-quote">'</span><span class="org-highlight-quoted-symbol">cdr</span> files)
    (list <span class="org-string">"Text"</span>))
   (seq-map
    (<span class="org-keyword">lambda</span> (item)
      (append
       (seq-map-indexed
        (<span class="org-keyword">lambda</span> (file file-index)
