list-style-type: disc;" data-uid="5"><span class="wprm-recipe-ingredient-amount">1</span> <span class="wprm-recipe-ingredient-unit">teaspoon</span> <span class="wprm-recipe-ingredient-name">kosher salt</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="6"><span class="wprm-recipe-ingredient-amount">&frac14;</span> <span class="wprm-recipe-ingredient-unit">teaspoon</span> <span class="wprm-recipe-ingredient-name">black pepper</span></li></ul></div><div class="wprm-recipe-ingredient-group"><h4 class="wprm-recipe-group-name wprm-recipe-ingredient-group-name wprm-block-text-bold">For The Candied Walnuts</h4><ul class="wprm-recipe-ingredients"><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="8"><span class="wprm-recipe-ingredient-amount">&frac12;</span> <span class="wprm-recipe-ingredient-unit">cup</span> <span class="wprm-recipe-ingredient-name">halved walnuts</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="9"><span class="wprm-recipe-ingredient-amount">2</span> <span class="wprm-recipe-ingredient-unit">tablespoons</span> <span class="wprm-recipe-ingredient-name">maple syrup</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="10"><span class="wprm-recipe-ingredient-amount">1/8</span> <span class="wprm-recipe-ingredient-unit">teaspoon</span> <span class="wprm-recipe-ingredient-name">flaky sea salt</span></li></ul></div><div class="wprm-recipe-ingredient-group"><h4 class="wprm-recipe-group-name wprm-recipe-ingredient-group-name wprm-block-text-bold">For The Dressing</h4><ul class="wprm-recipe-ingredients"><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="12"><span class="wprm-recipe-ingredient-amount">3</span> <span class="wprm-recipe-ingredient-unit">tablespoons</span> <span class="wprm-recipe-ingredient-name">olive oil</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="13"><span class="wprm-recipe-ingredient-amount">2</span> <span class="wprm-recipe-ingredient-unit">tablespoons</span> <span class="wprm-recipe-ingredient-name">fresh lemon juice</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="14"><span class="wprm-recipe-ingredient-amount">1</span> <span class="wprm-recipe-ingredient-name">garlic clove</span> <span class="wprm-recipe-ingredient-notes wprm-recipe-ingredient-notes-faded">minced</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="15"><span class="wprm-recipe-ingredient-amount">&frac12;</span> <span class="wprm-recipe-ingredient-unit">teaspoon</span> <span class="wprm-recipe-ingredient-name">kosher salt</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="16"><span class="wprm-recipe-ingredient-amount">&frac14;</span> <span class="wprm-recipe-ingredient-unit">teaspoon</span> <span class="wprm-recipe-ingredient-name">black pepper</span></li></ul></div><div class="wprm-recipe-ingredient-group"><h4 class="wprm-recipe-group-name wprm-recipe-ingredient-group-name wprm-block-text-bold">For The Salad:</h4><ul class="wprm-recipe-ingredients"><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="18"><span class="wprm-recipe-ingredient-amount">3</span> <span class="wprm-recipe-ingredient-unit">cups</span> <span class="wprm-recipe-ingredient-name">arugula leaves</span> <span class="wprm-recipe-ingredient-notes wprm-recipe-ingredient-notes-faded">loosely packed, rinsed and spin dried</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="19"><span class="wprm-recipe-ingredient-amount">&frac14;</span> <span class="wprm-recipe-ingredient-unit">cup</span> <span class="wprm-recipe-ingredient-name">crumbled feta cheese</span> <span class="wprm-recipe-ingredient-notes wprm-recipe-ingredient-notes-faded">2 oz.</span></li><li class="wprm-recipe-ingredient" style="list-style-type: disc;" data-uid="20"><span class="wprm-recipe-ingredient-amount">2</span> <span class="wprm-recipe-ingredient-unit">tablespoons</span> <span class="wprm-recipe-ingredient-name"><a href="https://amzn.to/47bfwSW" class="wprm-recipe-ingredient-link" target="_blank" rel="nofollow">Pomegranate molasses*</a></span> <span class="wprm-recipe-ingredient-notes wprm-recipe-ingredient-notes-faded">optional </span></li></ul></div></div>
<div id="recipe-83800-instructions" class="wprm-recipe-instructions-container wprm-recipe-83800-instructions-container wprm-block-text-normal" data-recipe="83800"><h3 class="wprm-recipe-header wprm-recipe-instructions-header wprm-block-text-bold wprm-align-left wprm-header-decoration-none" style="">Instructions</h3><div class="wprm-recipe-instruction-group"><ul class="wprm-recipe-instructions"><li id="wprm-recipe-83800-step-0-0" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Preheat your oven to 425&deg;F (220&deg;C). Line a sheet pan with parchment paper.</div></li><li id="wprm-recipe-83800-step-0-1" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Place cubed sweet potatoes, shallots, and chickpeas onto the baking sheet. Drizzle them with olive oil and sprinkle with salt and pepper. Toss to ensure they are evenly coated with the seasonings.</div><div class="wprm-recipe-instruction-media wprm-recipe-instruction-image"><img decoding="async" width="400" height="248" src="https://foolproofliving.com/wp-content/uploads/2025/10/Mediterranean-baked-sweet-potatoes-400x248.jpg" class="attachment-medium size-medium" alt="Roasted veggies on a sheet pan from the top view." srcset="https://foolproofliving.com/wp-content/uploads/2025/10/Mediterranean-baked-sweet-potatoes-400x248.jpg 400w, https://foolproofliving.com/wp-content/uploads/2025/10/Mediterranean-baked-sweet-potatoes-768x476.jpg 768w, https://foolproofliving.com/wp-content/uploads/2025/10/Mediterranean-baked-sweet-potatoes-150x93.jpg 150w, https://foolproofliving.com/wp-content/uploads/2025/10/Mediterranean-baked-sweet-potatoes.jpg 1200w" sizes="(max-width: 400px) 100vw, 400px" data-pin-media="https://foolproofliving.com/wp-content/uploads/2025/10/Mediterranean-baked-sweet-potatoes.jpg"></div> </li><li id="wprm-recipe-83800-step-0-2" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Roast for 20 minutes, tossing halfway through, until the potatoes are golden, the shallots are caramelized, and the chickpeas are lightly crispy.</div></li><li id="wprm-recipe-83800-step-0-3" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">To make the candied walnuts, in a small bowl, mix together the walnuts with maple syrup.</div><div class="wprm-recipe-instruction-media wprm-recipe-instruction-image"><img decoding="async" width="400" height="248" src="https://foolproofliving.com/wp-content/uploads/2025/10/Maple-candied-walnuts-for-salad-400x248.jpg" class="attachment-medium size-medium" alt="Candied walnuts in the making." srcset="https://foolproofliving.com/wp-content/uploads/2025/10/Maple-candied-walnuts-for-salad-400x248.jpg 400w, https://foolproofliving.com/wp-content/uploads/2025/10/Maple-candied-walnuts-for-salad-768x476.jpg 768w, https://foolproofliving.com/wp-content/uploads/2025/10/Maple-candied-walnuts-for-salad-150x93.jpg 150w, https://foolproofliving.com/wp-content/uploads/2025/10/Maple-candied-walnuts-for-salad.jpg 1200w" sizes="(max-width: 400px) 100vw, 400px" data-pin-media="https://foolproofliving.com/wp-content/uploads/2025/10/Maple-candied-walnuts-for-salad.jpg"></div> </li><li id="wprm-recipe-83800-step-0-4" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Line a small baking sheet with parchment paper and spread the walnuts evenly. Sprinkle them with a pinch of flaky sea salt and roast them in the oven for 5-7 minutes or until lightly toasted and golden. It is okay to roast them while the veggies are roasting.</div></li><li id="wprm-recipe-83800-step-0-5" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">When roasted, remove the veggies and walnuts from the oven and let them cool for 10-15 minutes.</div></li><li id="wprm-recipe-83800-step-0-6" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Meanwhile, make the salad dressing by whisking together olive oil, lemon juice, garlic, salt, and pepper in a bowl.</div><div class="wprm-recipe-instruction-media wprm-recipe-instruction-image"><img decoding="async" width="400" height="248" src="https://foolproofliving.com/wp-content/uploads/2025/10/dressing-for-sweet-potato-salad-400x248.jpg" class="attachment-medium size-medium" alt="Dressing for the salad and tossing the arugula with it by hand." srcset="https://foolproofliving.com/wp-content/uploads/2025/10/dressing-for-sweet-potato-salad-400x248.jpg 400w, https://foolproofliving.com/wp-content/uploads/2025/10/dressing-for-sweet-potato-salad-768x476.jpg 768w, https://foolproofliving.com/wp-content/uploads/2025/10/dressing-for-sweet-potato-salad-150x93.jpg 150w, https://foolproofliving.com/wp-content/uploads/2025/10/dressing-for-sweet-potato-salad.jpg 1200w" sizes="(max-width: 400px) 100vw, 400px" data-pin-media="https://foolproofliving.com/wp-content/uploads/2025/10/dressing-for-sweet-potato-salad.jpg"></div> </li><li id="wprm-recipe-83800-step-0-7" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">To assemble the salad, place the arugula in a large salad bowl. Drizzle it with the dressing and toss to coat.</div></li><li id="wprm-recipe-83800-step-0-8" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Pile the veggies on top and give it another big toss.</div><div class="wprm-recipe-instruction-media wprm-recipe-instruction-image"><img decoding="async" width="400" height="165" src="https://foolproofliving.com/wp-content/uploads/2025/10/sweet-potato-and-feta-cheese-salad-400x165.jpg" class="attachment-medium size-medium" alt="A collage of images showing the stages of the assembly of the recipe." srcset="https://foolproofliving.com/wp-content/uploads/2025/10/sweet-potato-and-feta-cheese-salad-400x165.jpg 400w, https://foolproofliving.com/wp-content/uploads/2025/10/sweet-potato-and-feta-cheese-salad.jpg 1200w, https://foolproofliving.com/wp-content/uploads/2025/10/sweet-potato-and-feta-cheese-salad-768x317.jpg 768w, https://foolproofliving.com/wp-content/uploads/2025/10/sweet-potato-and-feta-cheese-salad-150x62.jpg 150w" sizes="(max-width: 400px) 100vw, 400px" data-pin-media="https://foolproofliving.com/wp-content/uploads/2025/10/sweet-potato-and-feta-cheese-salad.jpg"></div> </li><li id="wprm-recipe-83800-step-0-9" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;"><span style="display: block;">Garnish with candied walnuts, crumbled feta, and drizzle with pomegranate molasses (if using) right before serving.</span></div></li></ul></div></div>

<div id="recipe-83800-notes" class="wprm-recipe-notes-container wprm-block-text-normal"><h3 class="wprm-recipe-header wprm-recipe-notes-header wprm-block-text-bold wprm-align-left wprm-header-decoration-none" style="">Notes</h3><div class="wprm-recipe-notes"><ul>
<li><strong>Yields:</strong> This recipe makes about 6-8 (loose) cups of salad that is ideal for serving 6 people as a side dish. The nutritional values below are per serving.</li>
<li>*A <strong>good substitute for pomegranate molasses</strong> is balsamic reduction. The flavor will change slightly, but it will still be delicious. Alternatively, if you do not have either of them, you can omit using them entirely.</li>
<li><span style="box-sizing: border-box; margin: 0px; padding: 0px;"><strong>Make ahead:</strong> You can prepare all components of the recipe in advance, let them reach room temperature, store them in an airtight container in the fridge, and assemble the salad right before serving.</span></li>
</ul></div></div>
