<div class="org-src-container">
<pre class="src src-emacs-lisp">(<span style="color: #ea3d54; font-weight: bold;">setq</span> jira-to-org-default-sprint <span style="color: #4fb3d8;">"s7"</span>)
</pre>
</div><br>
</div>
</div>
<div id="outline-container-orgdc93c8a" class="outline-4">
<h4 id="orgdc93c8a"><code>jira-to-org-default-year</code></h4>
<div class="outline-text-4" id="text-orgdc93c8a">
