   <span class="token punctuation">'(</span><span class="token car">read-only</span> <span class="token boolean">t</span> intangible <span class="token boolean">t</span> cursor-intangible <span class="token boolean">t</span> face minibuffer-prompt<span class="token punctuation">)</span><span class="token punctuation">)</span>
  <span class="token punctuation">(</span><span class="token car">minibuffer-depth-indicate-mode</span> <span class="token boolean">t</span><span class="token punctuation">)</span>
