<pre class="src src-emacs-lisp"><code>(subed-record-extract-all-approximately-matching-phrases
   (split-string (org-file-contents <span class="org-string">"/home/sacha/proj/french/analysis/virelangues-2026-03-13/phrases.txt"</span>) <span class="org-string">"\n"</span>)
