<pre>
<code><div class="cm-line">cd /var/lib/synapse</div><div class="cm-line">source .venv/bin/activate</div><div class="cm-line">synctl start</div><div class="cm-line"></div><div class="cm-line"></div><div class="cm-line"></div><div class="cm-line"></div><div class="cm-line"></div><div class="cm-line"></div></code></pre>
